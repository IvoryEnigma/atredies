# ====================================================================
# AIT Academia Hub - Environment Variables
# ====================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (find in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Allowed Email Domains (Comma-separated).
# Default AIT Pune domain: aitpune.edu.in.
# Leave blank or set to * to allow all during development/testing.
VITE_ALLOWED_EMAIL_DOMAINS=aitpune.edu.in
